# Use a private RPC/WebSocket provider for better launch latency.
RPC_HTTP_URL=
RPC_WS_URL=

# Optional only: the bot reads the actual chain ID from the RPC.
CHAIN_ID=
CHAIN_NAME=

# Optional OpenSea enrichment. Never required for direct RPC execution.
OPENSEA_API_KEY=
OPENSEA_ENABLED=1
OPENSEA_CHAIN=base
OPENSEA_TIMEOUT_MS=2500

# One or multiple NFT contract addresses, comma-separated.
# Change these in Render env vars without editing source code.
TARGET_NFT_CONTRACT_ADDRESS=0xContractOne,0xContractTwo

# Optional overrides. Leave blank to let safe common-pattern discovery inspect each CA.
MINT_FUNCTION=
MINT_ARGS_JSON=
MINT_TARGET=
# For SeaDrop V1, leave the three values above blank; discovery reads the
# collection's allowed SeaDrop config and builds mintPublic(...) safely.
MINT_QUANTITY=1
AUTO_DISCOVER_MINT=1

# Native payment example. For ERC-20 payment, fill the token fields.
PAYMENT_MODE=NATIVE
MINT_PRICE_NATIVE=0
PAYMENT_TOKEN_ADDRESS=
PAYMENT_AMOUNT=
APPROVAL_SPENDER=
AUTO_APPROVE=true

# Dynamic gas is calculated from the selected RPC and bounded by these caps.
GAS_BUFFER_BPS=2000
MAX_MINT_PRICE_NATIVE=0.05
MAX_APPROVAL_GAS_COST_NATIVE=0.001
MAX_TOTAL_COST_NATIVE=0.06

# Keep the private key local. Never paste it into chat or commit it.
SNIPER_PRIVATE_KEY=
SIMULATION_ADDRESS=

# Operator-facing mode switch: 1 = dry-run (default), 0 = live-capable.
DRY_RUN=1

# Second explicit live safety switch: must be 1 together with DRY_RUN=0.
LIVE_TRADING=0
